# ---------------------------------------------------------------------------
# NewzCrime environment variables
# Copy to .env and fill in. Never commit real values.
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- API ---
API_PORT=4000
API_BASE_URL=http://localhost:4000
# Comma-separated allowed origins for CORS (Expo dev + web)
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# --- Postgres -----------------------------------------------------------------
# Local dev (docker-compose):
#   DATABASE_URL=postgres://newzcrime:newzcrime@localhost:5432/newzcrime
#   DATABASE_URL_DIRECT=postgres://newzcrime:newzcrime@localhost:5432/newzcrime
#
# Supabase production — the two URLs are NOT interchangeable:
#   DATABASE_URL        = pooled connection, port 6543  -> API only
#   DATABASE_URL_DIRECT = direct connection, port 5432  -> worker, pg-boss,
#                                                          migrations
#
# pg-boss needs LISTEN/NOTIFY, which the transaction pooler (6543) does not
# support. Using the pooled URL for the worker yields a queue that never runs.
DATABASE_URL=postgres://newzcrime:newzcrime@localhost:5432/newzcrime
DATABASE_URL_DIRECT=postgres://newzcrime:newzcrime@localhost:5432/newzcrime

# --- Redis ---
# Local dev (docker-compose):
REDIS_URL=redis://localhost:6379
# Upstash production (REST):
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Supabase (production) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-side only. NEVER expose this to the mobile app.
SUPABASE_SERVICE_ROLE_KEY=

# --- Ingestion sources ---
# Podcast Index is free: https://podcastindex.org/developer
PODCAST_INDEX_API_KEY=
PODCAST_INDEX_API_SECRET=

# Deferred to v2 — not required for the v1 build. See docs/SCOPE.md.
# YOUTUBE_API_KEY=

# --- Worker ---
# Cron for the ingest scheduler (default: every 15 minutes)
INGEST_CRON=*/15 * * * *
LOG_LEVEL=info

# --- Mobile (apps/mobile) ---
# Expo only exposes EXPO_PUBLIC_* variables to the app bundle.
EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
