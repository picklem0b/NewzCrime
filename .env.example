[TEMPLATE]
# =========================================================================
# NewzCrime environment variables
#
# Copy to .env and fill in. Never commit real values.
#
# Production is Supabase-first:
#   Postgres  Supabase (free, 500 MB)      -> DATABASE_URL / DATABASE_URL_DIRECT
#   Cache     Upstash Redis (free, TLS)    -> REDIS_URL
#   API       Render free web service      -> the URLs below
#   Ingest    GitHub Actions (free)        -> .github/workflows/ingest.yml
#
# A Render-managed database is a supported fallback, not the default: paste its
# connection string into the same two variables. Nothing else changes.
# =========================================================================

NODE_ENV=development

# ===== API =====
API_PORT=4000
API_BASE_URL=http://localhost:4000
# Comma-separated allowed origins for CORS (Expo dev + web).
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
# Requests per IP per window, applied to the whole `/v1` surface.
API_RATE_LIMIT_MAX=300
API_RATE_LIMIT_WINDOW_MS=60000
LOG_LEVEL=info

# Pool size. Deliberately small: the free tiers allow a handful of
# connections, and a bigger pool queues against the database's own limit.
DB_POOL_MAX=5

# How many proxy hops to trust when reading the client IP.
# `false` when the API is reached directly (local dev, a bare container).
# Render puts one proxy in front, so production uses `1` — but trusting a
# proxy that is not there lets a caller spoof X-Forwarded-For and bypass the
# rate limit, so the default is not to trust anything.
TRUST_PROXY=false

# ===== Postgres =====
# Local dev (docker-compose or a local server):
#   DATABASE_URL=postgres://newzcrime:newzcrime@127.0.0.1:5432/newzcrime
#   DATABASE_URL_DIRECT=postgres://newzcrime:newzcrime@127.0.0.1:5432/newzcrime
#
# Supabase production — the two URLs are NOT interchangeable:
#   DATABASE_URL        = transaction pooler, port 6543 -> API reads
#   DATABASE_URL_DIRECT = session pooler,     port 5432 -> worker, pg-boss,
#                                                         migrations
#
# Copy both from Supabase → Project settings → Database → Connection string →
# URI, and keep `?sslmode=require` on the end. The session pooler is IPv4 and
# supports LISTEN/NOTIFY; `db.<ref>.supabase.co` is IPv6-only on newer projects.
#
# pg-boss needs LISTEN/NOTIFY, which the transaction pooler (6543) does not
# support. Using the pooled URL for the worker yields a queue that never runs.
# The API runs migrations on boot, so it needs the direct URL too.
#
# After pasting them, run `pnpm db:setup` (migrate + verify) and `pnpm ingest`.
DATABASE_URL=postgres://newzcrime:newzcrime@127.0.0.1:5432/newzcrime
DATABASE_URL_DIRECT=postgres://newzcrime:newzcrime@127.0.0.1:5432/newzcrime

# Render-managed Postgres fallback — same variables, its internal or external
# connection string. Render gives both roles one URL; set both keys to it.
# DATABASE_URL=postgres://...
# DATABASE_URL_DIRECT=postgres://...

# ===== Redis =====
# TCP endpoint. Local dev uses docker-compose; production uses Upstash
# (rediss:// for TLS). The API degrades to an in-process cache when this is
# unreachable or empty, so it is never a hard dependency.
REDIS_URL=redis://127.0.0.1:6379

# ===== Supabase =====
# The app does not use Supabase auth or storage in v1; these are here for the
# database and for a future server-side feature.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-side only. NEVER expose this to the mobile app.
SUPABASE_SERVICE_ROLE_KEY=

# ===== Ingestion sources =====
# Podcast Index is free: https://podcastindex.org/developer
# Discovery is skipped while these are empty; seeded feeds still ingest.
PODCAST_INDEX_API_KEY=
PODCAST_INDEX_API_SECRET=

# Deferred to v2 — not required for the v1 build. See docs/ROADMAP.md.
# YOUTUBE_API_KEY=

# ===== Worker =====
# Cron for the ingest scheduler (default: every 15 minutes).
# On the free deployment the scheduler is replaced by GitHub Actions; these
# values still drive a self-hosted worker.
INGEST_CRON=*/15 * * * *
# Kick off one ingest as soon as the worker starts, as well as on the cron.
WORKER_INGEST_ON_START=true
# Sent to publishers that reject unknown user agents.
WORKER_USER_AGENT=NewzCrimeBot/1.0 (+https://newzcrime.app)
WORKER_FETCH_TIMEOUT_MS=25000

# ===== Mobile (apps/mobile) =====
# Expo only exposes EXPO_PUBLIC_* variables to the app bundle. This is inlined
# at build time and used as the API base URL for all requests.
# Production: set to your Render API URL, e.g.
#   EXPO_PUBLIC_API_URL=https://newzcrime-api.onrender.com
EXPO_PUBLIC_API_URL=http://127.0.0.1:4000
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
