# ---------------------------------------------------------------------------
# NewzCrime environment variables
# Copy to .env and fill in. Never commit real values.
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- API ---
API_PORT=4000
API_BASE_URL=http://localhost:4000
# Comma-separated allowed origins for CORS (Expo dev + web).
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
# Requests per IP per window, applied to the whole `/v1` surface.
API_RATE_LIMIT_MAX=300
API_RATE_LIMIT_WINDOW_MS=60000
LOG_LEVEL=info

# --- Postgres -----------------------------------------------------------------
# Use 127.0.0.1 rather than localhost: some local Postgres servers listen on
# IPv4 only, and Node resolves localhost to ::1 first.
#
# Local dev (docker-compose or a local server):
#   DATABASE_URL=postgres://newzcrime:newzcrime@127.0.0.1:5432/newzcrime
#   DATABASE_URL_DIRECT=postgres://newzcrime:newzcrime@127.0.0.1:5432/newzcrime
#
# Supabase production — the two URLs are NOT interchangeable:
#   DATABASE_URL        = pooled connection, port 6543  -> API only
#   DATABASE_URL_DIRECT = direct connection, port 5432  -> worker, pg-boss,
#                                                          migrations
#
# pg-boss needs LISTEN/NOTIFY, which the transaction pooler (6543) does not
# support. Using the pooled URL for the worker yields a queue that never runs.
DATABASE_URL=postgres://newzcrime:newzcrime@127.0.0.1:5432/newzcrime
DATABASE_URL_DIRECT=postgres://newzcrime:newzcrime@127.0.0.1:5432/newzcrime

# --- Redis ---
# TCP endpoint. Local dev uses the docker-compose or local Redis; production
# uses Upstash's TCP endpoint (rediss:// for TLS). The API degrades to an
# in-process cache when this is unreachable, so it is never a hard dependency.
REDIS_URL=redis://127.0.0.1:6379

# --- Supabase (production) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-side only. NEVER expose this to the mobile app.
SUPABASE_SERVICE_ROLE_KEY=

# --- Ingestion sources ---
# Podcast Index is free: https://podcastindex.org/developer
# Discovery is skipped while these are empty; seeded feeds still ingest.
PODCAST_INDEX_API_KEY=
PODCAST_INDEX_API_SECRET=

# Deferred to v2 — not required for the v1 build. See docs/ROADMAP.md.
# YOUTUBE_API_KEY=

# --- Worker ---
# Cron for the ingest scheduler (default: every 15 minutes).
INGEST_CRON=*/15 * * * *
# Kick off one ingest as soon as the worker starts, as well as on the cron.
# Set to `false` when you only want the scheduled runs.
WORKER_INGEST_ON_START=true
# Sent to publishers that reject unknown user agents.
WORKER_USER_AGENT=NewzCrimeBot/1.0 (+https://newzcrime.app)
WORKER_FETCH_TIMEOUT_MS=25000

# --- Mobile (apps/mobile) ---
# Expo only exposes EXPO_PUBLIC_* variables to the app bundle.
EXPO_PUBLIC_API_URL=http://127.0.0.1:4000
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
