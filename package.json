{
  "name": "newzcrime",
  "version": "1.0.0",
  "private": true,
  "description": "One place for South African crime and court news, with podcasts to go deeper.",
  "author": "Lethabo KHEDAMA <lethabokhedama@gmail.com>",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:api": "pnpm --filter @newzcrime/api dev",
    "dev:worker": "pnpm --filter @newzcrime/worker dev",
    "dev:mobile": "pnpm --filter ./apps/mobile start",
    "db:migrate": "pnpm --filter @newzcrime/db migrate",
    "db:verify": "pnpm --filter @newzcrime/db verify",
    "db:setup": "pnpm --filter @newzcrime/db migrate && pnpm --filter @newzcrime/db verify",
    "ingest": "pnpm --filter @newzcrime/worker ingest",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
