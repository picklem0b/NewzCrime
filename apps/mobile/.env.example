# The mobile app reads its API base URL at build time. Expo inlines any
# variable prefixed with EXPO_PUBLIC_ into the bundle, so only put non-secret
# values here.
#
# Copy this file to `.env` in this directory (apps/mobile), not the repo root —
# Expo only loads env files that sit beside the app's package.json.
#
# Default when unset: http://127.0.0.1:4000
#
# 127.0.0.1 is correct when the API runs on the same device as the app, which is
# the case when you run the API in Termux next to your phone's Expo client.
# Point this at your machine's LAN address instead if the API runs elsewhere,
# for example http://192.168.1.20:4000.
EXPO_PUBLIC_API_URL=http://127.0.0.1:4000
